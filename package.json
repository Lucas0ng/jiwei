{
  "name": "jiwei",
  "version": "0.1.0",
  "description": "机位 · 照片拍法解析：上传照片或链接，AI 反推机位、参数与拍法，并生成拍摄策划与脚本",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "pages:build": "node scripts/build-pages.mjs",
    "pages:preview": "node scripts/build-pages.mjs && npx --yes serve@14.2.4 site -l 8789"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dompurify": "^3.2.0",
    "exifr": "^7.1.3",
    "express": "^5.1.0",
    "jsonrepair": "^3.12.0",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.166.0"
  }
}
